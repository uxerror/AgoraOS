extends SceneTree
## Writes docs/reference/programs.md from the package catalog: every
## package with its profiles, and each program's path and summary().
##   godot --headless --path . -s tools/gen_docs.gd

const OUT := "res://docs/reference/programs.md"


func _initialize() -> void:
	var names := AgoraDistro.catalog().keys()
	names.sort()
	var text := "# Programs and packages\n\n"
	text += "Generated by `tools/gen_docs.gd` from `system/distro.gd` and each program's\n`summary()`. Do not edit by hand; run the tool again after changing them:\n\n"
	text += "```sh\ngodot --headless --path . -s tools/gen_docs.gd\n```\n\n"
	text += "## Profiles\n\n| Profile | Packages |\n|---|---|\n"
	for profile: String in AgoraDistro.PROFILES:
		text += "| `%s` | %s |\n" % [profile, ", ".join((AgoraDistro.PROFILES[profile] as Array).map(func(n: String) -> String: return "`%s`" % n))]
	text += "\n## Packages\n"
	for name: String in names:
		var pkg := AgoraDistro.package(name)
		var in_profiles: PackedStringArray = []
		for profile: String in AgoraDistro.PROFILES:
			if (AgoraDistro.PROFILES[profile] as Array).has(name):
				in_profiles.append(profile)
		var desc := str(pkg.description).trim_suffix(".")
		desc = desc.left(1).to_upper() + desc.substr(1)
		text += "\n### %s\n\n%s. Profiles: %s.\n" % [name, desc, ", ".join(in_profiles) if not in_profiles.is_empty() else "none (install with `apkg install %s`)" % name]
		var deps: Array = pkg.get("depends", [])
		if not deps.is_empty():
			text += "Depends: %s.\n" % ", ".join(deps)
		var programs: Array = pkg.get("programs", [])
		if not programs.is_empty():
			text += "\n| Program | Path | What it does |\n|---|---|---|\n"
			for prog: String in programs:
				text += "| `%s` | `%s` | %s |\n" % [prog, AgoraPrograms.path_for(prog), _summary(prog)]
	var applets := AgoraDistro.BUSYBOX_APPLETS.keys()
	applets.sort()
	text += "\n## Busybox applets (router)\n\n`/bin/busybox` is one binary; each applet is a link to it and runs the program named here, printing busybox's own formats where they differ.\n\n| Applet | Runs |\n|---|---|\n"
	for a: String in applets:
		text += "| `%s` | `%s` |\n" % [a, AgoraDistro.BUSYBOX_APPLETS[a]]
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(text)
	f.close()
	print("wrote ", ProjectSettings.globalize_path(OUT))
	quit()


func _summary(prog: String) -> String:
	var script: Script = AgoraPrograms.lookup(prog)
	if script == null:
		return ""
	var p: Object = script.new()
	var s := str(p.call("summary")) if p.has_method("summary") else ""
	return s.replace("|", "\\|")
